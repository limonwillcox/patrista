8","H8147"]],[6004003,13.7,"s",["H3915","H68","H8147"]]],"f":[["Tertullian",1,["On Fasting"],"On the other hand, he whose \"heart\" was habitually found \"lifted up\"  rather than fattened up, who in forty days and as many nights maintained a fast above the power of human nature, while spiritual faith subministered strength (to his body),  both saw with his eyes God's glory,"]]},"12":{"l":[[44008026,10.0,"c",["G2597","G3598","G450"]],[40017009,9.7,"c",["G2597","G1781","G450"]],[40005025,8.2,"c",["G5035","G3598"]],[41006008,7.9,"c",["G3853","G3598","G142"]],[40010005,7.8,"c",["G3853","G3598","G565"]],[44005037,7.7,"c",["G868","G450","G622"]],[40002013,7.4,"c",["G125","G1453","G622"]],[44007015,7.2,"c",["G2597","G125"]],[2032008,30.1,"s",["H4541","H4118","H5493","H6680"]],[5031029,17.8,"s",["H7843","H5493","H6680","H1870"]],[7002017,17.6,"s",["H4118","H5493","H1870","H6680"]],[5013005,14.6,"s",["H6680","H4714","H1870","H5493"]],[39002008,13.9,"s",["H7843","H5493","H1870"]],[2032007,13.4,"s",["H7843","H3381","H4714"]],[9015006,12.7,"s",["H5493","H3381","H4714"]],[38010011,12.7,"s",["H5493","H3381","H4714"]]],"w":[[2032007,2,["Barnabas","Clement Rome"],["Barnabas: The Epistle of Barnabas","Clement Rome: The First Epistle of Clement"],"Yes [it is even so]; but let us inquire if the Lord has really given that testament which He swore to the fathers that He would give  to the people. He did give it; but they were not worthy to receive it, on account of their sins. For the prophet declares, \"And Moses was fasting"],[2024018,1,["Barnabas"],["Barnabas: The Epistle of Barnabas"],"Yes [it is even so]; but let us inquire if the Lord has really given that testament which He swore to the fathers that He would give  to the people. He did give it; but they were not worthy to receive it, on account of their sins. For the prophet declares, \"And Moses was fasting"],[2031018,1,["Barnabas"],["Barnabas: The Epistle of Barnabas"]],[23042006,1,["Barnabas"],["Barnabas: The Epistle of Barnabas"]],[23049006,1,["Barnabas"],["Barnabas: The Epistle of Barnabas"]],[23061001,1,["Barnabas"],["Barnabas: The Epistle of Barnabas"]],[58003005,1,["Barnabas"],["Barnabas: The Epistle of Barnabas"]],[2032009,1,["Clement Rome"],["Clement Rome: The First Epistle of Clement"]],[2032032,1,["Clement Rome"],["Clement Rome: The First Epistle of Clement"]]],"f":[["Barnabas",2,["The Epistle of Barnabas"],"It therefore behoves us, who inquire much concerning events at hand,  to search diligently into those things which are able to save us. Let us then utterly flee from all the works of iniquity, lest these should take hold of us; and let us hate the error of the present time, that"],["Clement Rome",1,["The First Epistle of Clement"],"Ye understand, beloved, ye understand well the Sacred Scriptures, and ye have looked very earnestly into the oracles of God. Call then these things to your remembrance. When Moses went up into the mount, and abode there, with fasting and humiliation, forty days and forty nights,"]]},"13":{"l":[[40018006,5.1,"c",["G5137"]],[41009042,5.1,"c",["G5137"]],[42015020,5.1,"c",["G5137"]],[42017002,5.1,"c",["G5137"]],[44015010,5.1,"c",["G5137"]],[44020037,5.1,"c",["G5137"]],[45016004,5.1,"c",["G5137"]],[45011010,2.5,"c",["G3577"]],[1049008,6.8,"s",["H6203"]],[2023027,6.8,"s",["H6203"]],[3005008,6.8,"s",["H6203"]],[5031027,6.8,"s",["H6203"]],[6007008,6.8,"s",["H6203"]],[6007012,6.8,"s",["H6203"]],[10022041,6.8,"s",["H6203"]],[12017014,6.8,"s",["H6203"]]]},"14":{"l":[[66011018,7.9,"c",["G3686","G1311","G1484"]],[66003005,7.8,"c",["G1813","G3686"]],[40006009,6.4,"c",["G3772","G3686"]],[42010020,6.4,"c",["G3772","G3686"]],[42011002,6.4,"c",["G3772","G3686"]],[42019038,6.4,"c",["G3772","G3686"]],[43012028,6.4,"c",["G3772","G3686"]],[44004012,6.4,"c",["G3772","G3686"]],[5026005,15.1,"s",["H6099","H7227","H1471"]],[19135010,15.1,"s",["H6099","H7227","H1471"]],[33004003,15.1,"s",["H6099","H7227","H1471"]],[38008022,15.1,"s",["H6099","H7227","H1471"]],[19009005,14.