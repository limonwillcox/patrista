{
  "name": "fathers-gateway",
  "private": true,
  "type": "module",
  "description": "Searchable public-domain Church Fathers library.",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit && NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "vite preview --host 127.0.0.1 --port 4173",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 vitest run",
    "parse-confessions": "node scripts/parse-confessions.mjs",
    "latin-library": "node scripts/latin-library/scrape.mjs --all",
    "latin-library:dry": "node scripts/latin-library/scrape.mjs --dry-run",
    "links:ingest": "node scripts/links/ingest-fixture.mjs",
    "links:ingest-hcf": "node scripts/links/ingest-hcf.mjs",
    "links:ingest-ecatena": "node scripts/links/ingest-ecana.mjs",
    "links:report": "node scripts/links/report.mjs",
    "links:pack": "node scripts/links/pack-sqlite.mjs",
    "clavis:import": "node scripts/clavis/import-works.mjs",
    "clavis:pack": "node scripts/clavis/pack-sqlite.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
